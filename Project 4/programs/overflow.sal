; overflow.sal - adds 1 to the largest 32-bit integer.
; The sum wraps to -2147483648 and ADD sets V. JVS then sets FLAG to 1.
DEC SUM
DEC FLAG
DEC ONE

LDI 1             ; address 3
STR ONE
LDI 2147483647    ; INT32_MAX
XCH               ; B = 2147483647, A = 0
LDA ONE           ; A = 1
ADD               ; A = -2147483648, V = 1, Z = 0
STR SUM
JVS 13            ; address 10
LDI 0             ; no overflow: FLAG = 0
JMP 14
LDI 1             ; address 13: overflow: FLAG = 1
STR FLAG          ; address 14
HLT
